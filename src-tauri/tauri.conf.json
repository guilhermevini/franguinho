{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Franguinho",
  "version": "0.2.0",
  "identifier": "dev.guilhermevini.franguinho",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Franguinho",
        "width": 420,
        "height": 740,
        "minWidth": 340,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Registra o início e o fim das suas tarefas",
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBMTlBREQzODNEQjQ4RDEKUldUUlNOdUQwNjBaNnJqMXJCZlBtaWNZa3NQL3VoaWxLWEhRdm9XUDROSjVKYzZYL0hic2YvZ3kK",
      "endpoints": [
        "https://github.com/guilhermevini/franguinho/releases/latest/download/latest.json"
      ]
    }
  }
}
